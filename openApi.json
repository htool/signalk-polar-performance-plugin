{
  "openapi": "3.0.3",
  "info": {
    "title": "Polar Performance Plugin API",
    "version": "1.0.0",
    "description": "REST API for polar library management and polar performance queries.\nAll speed values are in m/s, all angles in radians."
  },
  "servers": [
    { "url": "/plugins/signalk-polar-performance-plugin" }
  ],
  "tags": [
    {
      "name": "polar-manager",
      "description": "Polar library management: list, create, import, export, and select polars by id."
    },
    {
      "name": "polar-data",
      "description": "Legacy polar endpoints retained for backward compatibility. Individual endpoints will be superseded by polar-manager equivalents."
    },
    {
      "name": "polar-query",
      "description": "Polar performance queries: interpolate speed, targets, curves, and performance ratios for any stored polar. Pass 'active' as the id to query the currently active polar."
    }
  ],
  "paths": {

    "/polars": {
      "get": {
        "tags": ["polar-manager"],
        "operationId": "listPolars",
        "summary": "List all stored polars",
        "description": "Returns a summary of every polar in the library.",
        "responses": {
          "200": {
            "description": "Array of polar summaries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/PolarSummary" }
                }
              }
            }
          }
        }
      }
    },

    "/polars/active": {
      "get": {
        "tags": ["polar-manager"],
        "operationId": "getActivePolar",
        "summary": "Get the active polar id",
        "description": "Returns the id of the currently active polar.",
        "responses": {
          "200": {
            "description": "Active polar id",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/IdResponse" } } }
          },
          "404": {
            "description": "No polar is currently active",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      },
      "put": {
        "tags": ["polar-manager"],
        "operationId": "setActivePolar",
        "summary": "Set the active polar",
        "description": "Makes the identified polar the active polar for live computation.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/IdResponse" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Active polar updated",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/IdResponse" } } }
          },
          "404": {
            "description": "Polar not found",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },

    "/polars/formats": {
      "get": {
        "tags": ["polar-manager"],
        "operationId": "listFormats",
        "summary": "List supported polar file formats",
        "description": "Returns the set of format identifiers accepted by the import and export endpoints.",
        "responses": {
          "200": {
            "description": "Supported formats",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/FormatDescriptor" }
                }
              }
            }
          }
        }
      }
    },

    "/polars/meta/{id}": {
      "get": {
        "tags": ["polar-manager"],
        "operationId": "getPolarMeta",
        "summary": "Get polar metadata",
        "description": "Returns the stored metadata for the identified polar: name, sailnumber, boatType, year, source, notes",
        "parameters": [
          { "$ref": "#/components/parameters/polarId" }
        ],
        "responses": {
          "200": {
            "description": "Polar metadata",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PolarMeta" } } }
          },
          "404": {
            "description": "Polar not found",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },

    "/polars/export/{id}": {
      "get": {
        "tags": ["polar-manager"],
        "operationId": "exportPolar",
        "summary": "Export a polar in a named format",
        "description": "Returns the polar content rendered in the requested format. Use GET /polars/formats to discover supported export formats.",
        "parameters": [
          { "$ref": "#/components/parameters/polarId" },
          {
            "name": "format",
            "in": "query",
            "required": true,
            "description": "Target format identifier (e.g. jieter). Use GET /polars/formats for available values.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Polar content in the requested format. Content-Type reflects the format.",
            "content": {
              "text/plain":       { "schema": { "type": "string" } },
              "application/json": { "schema": { "type": "object" } }
            }
          },
          "400": {
            "description": "Unsupported or missing format parameter",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "404": {
            "description": "Polar not found",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },

    "/polars/import/sources": {
      "get": {
        "tags": ["polar-manager"],
        "operationId": "listImportSources",
        "summary": "List supported external import sources",
        "description": "Returns the external data sources from which polars can be imported (e.g. ORC).",
        "responses": {
          "200": {
            "description": "Available import sources",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/ImportSource" }
                }
              }
            }
          }
        }
      }
    },

    "/polars/import/search/{source}": {
      "get": {
        "tags": ["polar-manager"],
        "operationId": "searchImportSource",
        "summary": "Search an external polar source",
        "description": "Queries the named external source for matching boats. Requires internet access. The source identifier is obtained from GET /polars/import/sources.",
        "parameters": [
          {
            "name": "source",
            "in": "path",
            "required": true,
            "description": "Source identifier (from GET /polars/import/sources)",
            "schema": { "type": "string" }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search term matched against boat name, sail number, and type",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching boats",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/ExternalBoat" }
                }
              }
            }
          },
          "404": {
            "description": "Source not found",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "502": {
            "description": "Failed to reach external source",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },

    "/polars/import/text/{format}": {
      "post": {
        "tags": ["polar-manager"],
        "operationId": "importPolarFromText",
        "summary": "Import a polar from text content",
        "description": "Parses the supplied text content in the named format and stores it as a new polar in the library. Use GET /polars/formats to discover supported import formats. If no id is supplied in the body, one is generated from the sailnumber or assigned automatically.",
        "parameters": [
          {
            "name": "format",
            "in": "path",
            "required": true,
            "description": "Format identifier of the supplied content (e.g. jieter)",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/PolarImportBody" } }
          }
        },
        "responses": {
          "200": {
            "description": "Polar stored successfully",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/IdResponse" } } }
          },
          "400": {
            "description": "Invalid or unparseable content, or unsupported format",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },

    "/polars/import/{source}/{externalId}": {
      "post": {
        "tags": ["polar-manager"],
        "operationId": "importPolarFromSource",
        "summary": "Import a polar from an external source",
        "description": "Fetches the polar identified by externalId from the named source and stores it in the local library. The externalId is obtained from GET /polars/import/search/{source}. Requires internet access.",
        "parameters": [
          {
            "name": "source",
            "in": "path",
            "required": true,
            "description": "Source identifier (from GET /polars/import/sources)",
            "schema": { "type": "string" }
          },
          {
            "name": "externalId",
            "in": "path",
            "required": true,
            "description": "External polar identifier within the source (from GET /polars/import/search/{source})",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": false,
          "description": "Optional overrides for the stored id and display metadata.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id":    { "type": "string", "description": "Desired local id. Defaults to externalId if omitted." },
                  "name":  { "type": "string" },
                  "notes": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Polar imported and stored",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/IdResponse" } } }
          },
          "404": {
            "description": "Source or externalId not found",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "502": {
            "description": "Failed to reach external source",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },

    "/polars/tws/{id}": {
      "get": {
        "tags": ["polar-query"],
        "operationId": "getPolarTws",
        "summary": "TWS values available in a polar",
        "description": "Returns the array of true wind speed values (m/s) for which the polar has tabulated data. Pass 'active' as id to query the currently active polar.",
        "parameters": [
          { "$ref": "#/components/parameters/polarId" }
        ],
        "responses": {
          "200": {
            "description": "TWS values in m/s",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "type": "number" } }
              }
            }
          },
          "404": {
            "description": "Polar not found or no active polar",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },

    "/polars/curve/{id}": {
      "get": {
        "tags": ["polar-query"],
        "operationId": "getPolarCurve",
        "summary": "Interpolated polar curve at a given TWS",
        "description": "Returns a sampled polar curve at the requested TWS, including beat and run target markers. Pass 'active' as id to query the currently active polar.",
        "parameters": [
          { "$ref": "#/components/parameters/polarId" },
          {
            "name": "tws",
            "in": "query",
            "required": true,
            "description": "True wind speed in m/s",
            "schema": { "type": "number", "minimum": 0 }
          },
          {
            "name": "step",
            "in": "query",
            "required": false,
            "description": "Angular sampling step in radians (default ~0.035 rad = 2 deg)",
            "schema": { "type": "number", "minimum": 0 }
          }
        ],
        "responses": {
          "200": {
            "description": "Polar curve data",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PolarCurveResult" } } }
          },
          "400": {
            "description": "Missing or invalid query parameters",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "404": {
            "description": "Polar not found or no active polar",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },

    "/polars/speed/{id}": {
      "get": {
        "tags": ["polar-query"],
        "operationId": "getPolarSpeed",
        "summary": "Interpolated boat speed at a TWS/TWA point",
        "description": "Returns the polar boat speed at the given true wind speed and angle, plus interpolation quality indicators. Pass 'active' as id to query the currently active polar.",
        "parameters": [
          { "$ref": "#/components/parameters/polarId" },
          {
            "name": "tws",
            "in": "query",
            "required": true,
            "description": "True wind speed in m/s",
            "schema": { "type": "number", "minimum": 0 }
          },
          {
            "name": "twa",
            "in": "query",
            "required": true,
            "description": "True wind angle in radians (positive, 0 to pi)",
            "schema": { "type": "number", "minimum": 0 }
          }
        ],
        "responses": {
          "200": {
            "description": "Interpolated speed result",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PolarSpeedResult" } } }
          },
          "400": {
            "description": "Missing or invalid query parameters",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "404": {
            "description": "Polar not found or no active polar",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },

    "/polars/targets/{id}": {
      "get": {
        "tags": ["polar-query"],
        "operationId": "getPolarTargets",
        "summary": "Optimal beat and run targets at a given TWS",
        "description": "Returns the optimal beat and run angles, boat speeds, and VMG values at the given true wind speed. Pass 'active' as id to query the currently active polar.",
        "parameters": [
          { "$ref": "#/components/parameters/polarId" },
          {
            "name": "tws",
            "in": "query",
            "required": true,
            "description": "True wind speed in m/s",
            "schema": { "type": "number", "minimum": 0 }
          }
        ],
        "responses": {
          "200": {
            "description": "Beat and run targets",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PolarTargetsResult" } } }
          },
          "400": {
            "description": "Missing or invalid query parameters",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "404": {
            "description": "Polar not found or no active polar",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },

    "/polars/performance/{id}": {
      "get": {
        "tags": ["polar-query"],
        "operationId": "getPolarPerformance",
        "summary": "Performance ratio against the polar",
        "description": "Given actual TWS, TWA, and BSP, returns the polar target speed and performance ratio, plus VMG performance. VMG is upwind when TWA < 60 deg (1.047 rad), downwind when TWA > 120 deg (2.094 rad), and null for reaching in between. Pass 'active' as id to query the currently active polar.",
        "parameters": [
          { "$ref": "#/components/parameters/polarId" },
          {
            "name": "tws",
            "in": "query",
            "required": true,
            "description": "True wind speed in m/s",
            "schema": { "type": "number", "minimum": 0 }
          },
          {
            "name": "twa",
            "in": "query",
            "required": true,
            "description": "True wind angle in radians (positive, 0 to pi)",
            "schema": { "type": "number", "minimum": 0 }
          },
          {
            "name": "bsp",
            "in": "query",
            "required": true,
            "description": "Actual boat speed in m/s",
            "schema": { "type": "number", "minimum": 0 }
          }
        ],
        "responses": {
          "200": {
            "description": "Performance result",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PolarPerformanceResult" } } }
          },
          "400": {
            "description": "Missing or invalid query parameters",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "404": {
            "description": "Polar not found or no active polar",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },

    "/polars/{id}": {
      "parameters": [
        { "$ref": "#/components/parameters/polarId" }
      ],
      "get": {
        "tags": ["polar-data"],
        "operationId": "downloadPolarRaw",
        "summary": "Download raw polar file (legacy)",
        "description": "Returns the raw file content (CSV or JSON) for the named polar. Superseded by GET /polars/export/{id}.",
        "responses": {
          "200": {
            "description": "Raw polar file content",
            "content": { "text/plain": { "schema": { "type": "string" } } }
          },
          "404": {
            "description": "Polar not found",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      },
      "post": {
        "tags": ["polar-data"],
        "operationId": "uploadPolarCsvLegacy",
        "summary": "Upload or replace a polar CSV file (legacy)",
        "description": "Saves the supplied CSV content as the named polar file. Superseded by POST /polars/import/text/{format}.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["csv"],
                "properties": {
                  "csv":        { "type": "string" },
                  "boatName":   { "type": "string" },
                  "boatType":   { "type": "string" },
                  "sailnumber": { "type": "string" }
                }
              }
            },
            "text/plain": { "schema": { "type": "string" } }
          }
        },
        "responses": {
          "200": {
            "description": "Polar saved",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "ok": { "type": "boolean" } } } } }
          },
          "400": {
            "description": "Invalid body",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      },
      "put": {
        "tags": ["polar-manager"],
        "operationId": "upsertPolar",
        "summary": "Create or replace a polar",
        "description": "Stores the supplied polar content under the given id. Creates the polar if it does not exist; replaces it if it does. The format of the supplied content must be specified via the format query parameter.",
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "required": true,
            "description": "Format of the supplied content (e.g. jieter). Use GET /polars/formats for available values.",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/PolarUpsertBody" } }
          }
        },
        "responses": {
          "200": {
            "description": "Polar stored",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/IdResponse" } } }
          },
          "400": {
            "description": "Invalid content or unsupported format",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      },
      "delete": {
        "tags": ["polar-manager"],
        "operationId": "deletePolar",
        "summary": "Delete a polar",
        "description": "Permanently removes the identified polar from the library.",
        "responses": {
          "200": {
            "description": "Polar deleted",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/IdResponse" } } }
          },
          "404": {
            "description": "Polar not found",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },

    "/polars/import/search": {
      "get": {
        "tags": ["polar-data"],
        "operationId": "searchOrcLegacy",
        "summary": "Search the ORC database (legacy)",
        "description": "Fetches the ORC polar index and filters by query. Superseded by GET /polars/import/search/{source}.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search term matched against boat name, sail number, and type",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching boats",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name":       { "type": "string" },
                      "sailnumber": { "type": "string" },
                      "type":       { "type": "string" },
                      "year":       { "type": "integer" }
                    }
                  }
                }
              }
            }
          },
          "502": {
            "description": "Failed to fetch ORC data (network error)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },

    "/polars/import/{sailnumber}": {
      "post": {
        "tags": ["polar-data"],
        "operationId": "importOrcLegacy",
        "summary": "Import a polar from the ORC database (legacy)",
        "description": "Downloads VPP data for the given sail number from the ORC database and saves it locally. Superseded by POST /polars/import/{source}/{externalId}.",
        "parameters": [
          {
            "name": "sailnumber",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Polar imported successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok":   { "type": "boolean" },
                    "name": { "type": "string", "description": "Saved polar name (same as sail number)" }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Sail number not found in ORC data",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "500": {
            "description": "Import or save failed",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },

    "/polars/active/{name}": {
      "put": {
        "tags": ["polar-data"],
        "operationId": "setActivePolarLegacy",
        "summary": "Set the active polar (legacy)",
        "description": "Loads the named polar and makes it the active polar. Superseded by PUT /polars/active.",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "description": "Bare polar name (without .csv extension)",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Active polar updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok":          { "type": "boolean" },
                    "activePolar": { "type": "string" }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Polar file could not be loaded",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },

    "/polar/tws": {
      "get": {
        "tags": ["polar-data"],
        "operationId": "getActivePolarTws",
        "summary": "Available TWS values in the active polar",
        "description": "Returns an array of true wind speed values (m/s) for which the active polar has data rows, excluding the zero-padding entry.",
        "responses": {
          "200": {
            "description": "TWS values in m/s",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "type": "number" } }
              }
            }
          },
          "503": {
            "description": "No polar loaded",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },

    "/polar/curve": {
      "get": {
        "tags": ["polar-data"],
        "operationId": "getActivePolarCurve",
        "summary": "Interpolated polar curve for a given TWS",
        "description": "Returns a sampled polar curve at the requested TWS for the active polar, including beat and run angle/VMG markers.",
        "parameters": [
          {
            "name": "tws",
            "in": "query",
            "required": true,
            "description": "True wind speed in m/s",
            "schema": { "type": "number", "minimum": 0 }
          },
          {
            "name": "step",
            "in": "query",
            "required": false,
            "description": "Angular sampling step in radians (default ~0.035 rad = 2 deg)",
            "schema": { "type": "number", "minimum": 0 }
          }
        ],
        "responses": {
          "200": {
            "description": "Polar curve data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "tws":    { "type": "number", "description": "Requested TWS (m/s)" },
                    "points": {
                      "type": "array",
                      "description": "Sampled points from 0 to pi",
                      "items": {
                        "type": "object",
                        "properties": {
                          "twa": { "type": "number", "description": "True wind angle (rad)" },
                          "tbs": { "type": "number", "description": "Boat speed (m/s)" }
                        }
                      }
                    },
                    "beat": {
                      "nullable": true,
                      "type": "object",
                      "properties": {
                        "twa": { "type": "number" },
                        "tbs": { "type": "number" },
                        "vmg": { "type": ["number", "null"] }
                      }
                    },
                    "run": {
                      "nullable": true,
                      "type": "object",
                      "properties": {
                        "twa": { "type": "number" },
                        "tbs": { "type": "number" },
                        "vmg": { "type": ["number", "null"] }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid query parameters",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "503": {
            "description": "No polar loaded",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    }

  },

  "components": {
    "parameters": {
      "polarId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Polar identifier",
        "schema": { "type": "string" }
      }
    },
    "schemas": {

      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string" }
        }
      },

      "IdResponse": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" }
        }
      },

      "PolarSummary": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id":         { "type": "string",  "description": "Opaque stable identifier for this polar" },
          "name":       { "type": "string",  "description": "Human-readable label" },
          "sailnumber": { "type": "string" },
          "boatType":   { "type": "string" },
          "year":       { "type": "integer", "description": "Certificate or measurement year" },
          "source":     { "type": "string",  "description": "Data origin, e.g. orc, irc, measured, custom" }
        }
      },

      "PolarMeta": {
        "allOf": [
          { "$ref": "#/components/schemas/PolarSummary" },
          {
            "type": "object",
            "properties": {
              "notes":  { "type": "string" },
              "twsMin": { "type": "number", "description": "Lowest available TWS in the table (m/s)" },
              "twsMax": { "type": "number", "description": "Highest available TWS in the table (m/s)" }
            }
          }
        ]
      },

      "PolarImportBody": {
        "type": "object",
        "required": ["content"],
        "description": "Body for POST /polars/import/text/{format}. The id field is optional; if omitted, one is derived from sailnumber or generated automatically.",
        "properties": {
          "content":    { "type": "string",  "description": "Raw polar text content in the target format" },
          "id":         { "type": "string",  "description": "Desired local id. Auto-assigned if omitted." },
          "name":       { "type": "string" },
          "sailnumber": { "type": "string" },
          "boatType":   { "type": "string" },
          "year":       { "type": "integer" },
          "source":     { "type": "string" },
          "notes":      { "type": "string" }
        }
      },

      "PolarUpsertBody": {
        "type": "object",
        "required": ["content"],
        "description": "Body for PUT /polars/{id}. The id comes from the path.",
        "properties": {
          "content":    { "type": "string",  "description": "Raw polar text content in the format specified by the format query parameter" },
          "name":       { "type": "string" },
          "sailnumber": { "type": "string" },
          "boatType":   { "type": "string" },
          "year":       { "type": "integer" },
          "source":     { "type": "string" },
          "notes":      { "type": "string" }
        }
      },

      "FormatDescriptor": {
        "type": "object",
        "required": ["id", "name", "canImport", "canExport"],
        "properties": {
          "id":          { "type": "string",  "description": "Format identifier used in path and query parameters" },
          "name":        { "type": "string",  "description": "Human-readable format name" },
          "description": { "type": "string" },
          "canImport":   { "type": "boolean" },
          "canExport":   { "type": "boolean" }
        }
      },

      "ImportSource": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id":          { "type": "string" },
          "name":        { "type": "string" },
          "url":         { "type": "string" },
          "description": { "type": "string" }
        }
      },

      "ExternalBoat": {
        "type": "object",
        "required": ["externalId"],
        "properties": {
          "externalId":  { "type": "string",  "description": "ID used in POST /polars/import/{source}/{externalId}" },
          "name":        { "type": "string" },
          "sailnumber":  { "type": "string" },
          "boatType":    { "type": "string" },
          "year":        { "type": "integer" }
        }
      },

      "PolarTargetPoint": {
        "type": "object",
        "description": "Optimal sailing target (beat or run).",
        "properties": {
          "twa": { "type": "number", "description": "Optimal true wind angle (rad)" },
          "tbs": { "type": "number", "description": "Boat speed at optimal angle (m/s)" },
          "vmg": { "type": "number", "description": "Velocity made good at optimal angle (m/s)" }
        }
      },

      "PolarCurveResult": {
        "type": "object",
        "properties": {
          "tws":    { "type": "number", "description": "Requested TWS (m/s)" },
          "points": {
            "type": "array",
            "description": "Sampled points from 0 to pi",
            "items": {
              "type": "object",
              "properties": {
                "twa": { "type": "number", "description": "True wind angle (rad)" },
                "tbs": { "type": "number", "description": "Boat speed (m/s)" }
              }
            }
          },
          "beat": { "nullable": true, "$ref": "#/components/schemas/PolarTargetPoint" },
          "run":  { "nullable": true, "$ref": "#/components/schemas/PolarTargetPoint" }
        }
      },

      "PolarSpeedResult": {
        "type": "object",
        "properties": {
          "tws":   { "type": "number", "description": "True wind speed (m/s)" },
          "twa":   { "type": "number", "description": "True wind angle (rad)" },
          "tbs":   { "type": ["number", "null"], "description": "Interpolated boat speed (m/s), null if outside polar range" },
          "state": {
            "type": "object",
            "description": "Interpolation quality indicators.",
            "properties": {
              "tws": { "type": "string", "enum": ["below_range", "in_range", "above_range"] },
              "twa": { "type": "string", "enum": ["in_irons", "pinching", "in_range", "above_range"] }
            }
          }
        }
      },

      "PolarTargetsResult": {
        "type": "object",
        "properties": {
          "tws":  { "type": "number", "description": "True wind speed (m/s)" },
          "beat": { "nullable": true, "$ref": "#/components/schemas/PolarTargetPoint" },
          "run":  { "nullable": true, "$ref": "#/components/schemas/PolarTargetPoint" }
        }
      },

      "PerformanceMetric": {
        "type": "object",
        "properties": {
          "polar":  { "type": "number", "description": "Polar reference value (m/s)" },
          "actual": { "type": "number", "description": "Actual measured value (m/s)" },
          "ratio":  { "type": "number", "description": "actual / polar" }
        }
      },

      "PolarPerformanceResult": {
        "type": "object",
        "properties": {
          "tws":       { "type": "number", "description": "True wind speed (m/s)" },
          "twa":       { "type": "number", "description": "True wind angle (rad)" },
          "bsp":       { "type": "number", "description": "Actual boat speed (m/s)" },
          "direction": {
            "type": "string",
            "enum": ["upwind", "reaching", "downwind"],
            "description": "Point of sail. upwind: TWA < 60 deg (1.047 rad); downwind: TWA > 120 deg (2.094 rad); reaching: between."
          },
          "speed": { "$ref": "#/components/schemas/PerformanceMetric" },
          "vmg":   {
            "nullable": true,
            "$ref": "#/components/schemas/PerformanceMetric",
            "description": "null when direction is reaching"
          }
        }
      }

    }
  }
}
