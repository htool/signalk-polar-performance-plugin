{
  "openapi": "3.0.3",
  "info": {
    "title": "Polar Performance Plugin API",
    "version": "2.0.0",
    "description": "REST API for polar performance queries against the currently active polar. Polar storage, selection, and import are handled by a separate 'polars' resource-provider plugin (e.g. signalk-polar-management); this API only exposes read-only queries against whichever polar is currently active.\nAll speed values are in m/s, all angles in radians."
  },
  "servers": [
    { "url": "/plugins/signalk-polar-performance-plugin" }
  ],
  "tags": [
    {
      "name": "polar-query",
      "description": "Read-only queries against the currently active polar: axes and interpolated curve."
    }
  ],
  "paths": {

    "/polar/axes/tws": {
      "get": {
        "tags": ["polar-query"],
        "operationId": "getActivePolarTws",
        "summary": "TWS values available in the active polar",
        "description": "Returns the array of true wind speed values (m/s) for which the active polar has tabulated data.",
        "responses": {
          "200": {
            "description": "TWS values in m/s",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "type": "number" } }
              }
            }
          },
          "404": {
            "description": "No active polar selected",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },

    "/polar/queries/curve": {
      "get": {
        "tags": ["polar-query"],
        "operationId": "getActivePolarCurve",
        "summary": "Interpolated polar curve at a given TWS",
        "description": "Returns a sampled curve for the active polar at the requested TWS, including beat and run target markers, with the currently active performance factor already applied.",
        "parameters": [
          {
            "name": "tws",
            "in": "query",
            "required": true,
            "description": "True wind speed in m/s",
            "schema": { "type": "number", "minimum": 0 }
          },
          {
            "name": "step",
            "in": "query",
            "required": false,
            "description": "Angular sampling step in radians (default ~0.035 rad = 2 deg)",
            "schema": { "type": "number", "minimum": 0 }
          }
        ],
        "responses": {
          "200": {
            "description": "Polar curve data",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PolarCurveResult" } } }
          },
          "400": {
            "description": "Missing or invalid query parameters",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "404": {
            "description": "No active polar selected",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    }

  },

  "components": {
    "schemas": {

      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string" }
        }
      },

      "PolarTargetPoint": {
        "type": "object",
        "description": "Optimal sailing target (beat or run).",
        "properties": {
          "twa": { "type": "number", "description": "Optimal true wind angle (rad)" },
          "tbs": { "type": "number", "description": "Boat speed at optimal angle (m/s)" },
          "vmg": { "type": "number", "description": "Velocity made good at optimal angle (m/s)" }
        }
      },

      "PolarCurveResult": {
        "type": "object",
        "properties": {
          "tws":    { "type": "number", "description": "Requested TWS (m/s)" },
          "points": {
            "type": "array",
            "description": "Sampled points from 0 to pi",
            "items": {
              "type": "object",
              "properties": {
                "twa": { "type": "number", "description": "True wind angle (rad)" },
                "tbs": { "type": "number", "description": "Boat speed (m/s)" }
              }
            }
          },
          "beat": { "nullable": true, "$ref": "#/components/schemas/PolarTargetPoint" },
          "run":  { "nullable": true, "$ref": "#/components/schemas/PolarTargetPoint" }
        }
      }

    }
  }
}
